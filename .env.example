# ==============================================================================
# AstroSight Environment Configuration (.env.example)
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="AstroSight: Lunar Crater Image Classification and Spatial Analysis"
API_V1_STR="/api/v1"

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# Security & Cryptography (Generate a 64-char hex key: `openssl rand -hex 32`)
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (SQLite default for dev; PostgreSQL for production)
DATABASE_URL=sqlite:///./backend/data/astrosight.db
# Example Production: postgresql://user:password@localhost:5432/astrosight_db

# CORS Configuration (Comma-separated list of allowed origins; NO wildcards with credentials)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Upload & Resource Limits
MAX_UPLOAD_SIZE_MB=50
MAX_IMAGE_WIDTH_PX=8000
MAX_IMAGE_HEIGHT_PX=8000
PRIVATE_STORAGE_DIR=./backend/data

# Rate Limiting
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_REGISTER="3/minute"
RATE_LIMIT_PASSWORD_RESET="3/minute"
RATE_LIMIT_ANALYSIS="20/minute"

# Admin Initial Seed (Optional: auto-seeded on first launch if empty)
INITIAL_ADMIN_EMAIL=VTU30097@astrosight.vel.tech
INITIAL_ADMIN_PASSWORD=Srikiran@2006
